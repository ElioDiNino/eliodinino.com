{
  "name": "eliodinino.com",
  "version": "4.0",
  "private": true,
  "description": "Elio Di Nino's personal website",
  "author": "Elio Di Nino",
  "homepage": "https://eliodinino.com",
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "test": "cypress run",
    "test:visual": "cypress run --spec cypress/e2e/visual.cy.ts",
    "test:visual:generate": "pnpm run test:visual --env visualRegressionType=base",
    "test:interactive": "cypress open"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/overpass-mono": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@matt-block/react-recaptcha-v2": "^2.2.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@plausible-analytics/tracker": "^0.4.6",
    "@sentry/react": "^10.70.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-responsive": "^10.0.1",
    "react-router": "^8.3.0",
    "typeit-react": "^2.7.8",
    "typescript": "^7.0.2",
    "web-vitals": "^6.1.0"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.4.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "cypress": "^15.20.0",
    "cypress-visual-regression": "^6.0.0",
    "prettier": "^3.9.6",
    "vite": "^8.2.1",
    "vite-plugin-svgr": "^5.2.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "last 2 versions"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
